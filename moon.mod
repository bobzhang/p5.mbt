name = "bobzhang/p5"

version = "0.3.1"

readme = "README.md"

repository = "https://github.com/bobzhang/p5.mbt"

license = "LGPL-2.1"

keywords = [ "p5", "p5.js", "creative-coding", "canvas", "graphics", "webgl" ]

description = "A port of p5.js 2.x to MoonBit (JS backend): 2D canvas and WEBGL, fonts, SVG, GIF, shaders; pixel-identical with p5.js on its parity suite."

preferred_target = "js"

warnings = "-79"
