name = "bobzhang/p5_demos"

version = "0.2.2"

readme = "README.md"

repository = "https://github.com/bobzhang/p5.mbt"

license = "LGPL-2.1"

keywords = [
  "p5",
  "p5.js",
  "creative-coding",
  "demos",
  "webgl",
  "generative-art",
]

description = "Demos for p5.mbt (MoonBit's port of p5.js): WEBGL scenes, shaders, particles, generative art and three short films."

preferred_target = "js"

warnings = "-79"

import {
  "bobzhang/p5@0.3.2",
}
