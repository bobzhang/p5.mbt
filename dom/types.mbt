// Thin JavaScript bindings used by the p5 renderer and event system.
// Everything in this package requires the JS backend and a browser DOM.

///|
/// An `HTMLCanvasElement`.
#external
pub type Canvas

///|
/// A `CanvasRenderingContext2D`.
#external
pub type Context2D

///|
/// A `Path2D`.
#external
pub type Path2D

///|
/// An `HTMLImageElement` (or any `CanvasImageSource`).
#external
pub type ImageElement

///|
/// An `ImageData`.
#external
pub type ImageData

///|
/// A DOM `Element`.
#external
pub type Element
