pub(all) enum RendererKind {
  P2D
  WebGL
}

pub(all) struct SavedFrame {
  image_data : String
  filename : String
  ext : String
}

#derive(Eq, @debug.Debug)
pub(all) enum ShapeAlign {
  AlignCorner
  AlignCenter
  AlignViewBox
}

pub struct ShapeCollection {
  ops : Array[DrawOp]
  bounds : (Double, Double, Double, Double)
}

pub(all) enum SplineProperty {
  Ends(@shape.SplineEnds)
  Tightness(Double)
}

#derive(Eq, @debug.Debug)
pub(all) enum StrokeCap {
  Round
  Square
  Project
}

#derive(Eq, @debug.Debug)
pub(all) enum StrokeJoin {
  Miter
  Bevel
  RoundJoin
}

#derive(Eq, @debug.Debug)
pub(all) enum StrokeMode {
  Simple
  Full
}

#derive(@debug.Debug)
pub(all) struct TextMetrics {
  width : Double
  actual_left : Double
  actual_right : Double
  actual_ascent : Double
  actual_descent : Double
  font_ascent : Double
  font_descent : Double
  alphabetic_baseline : Double
}

#derive(@debug.Debug)
pub(all) struct TextPoint {
  x : Double
  y : Double
  angle : Double
}
pub fn TextPoint::alpha(Self) -> Double

#derive(Eq, @debug.Debug)
pub(all) enum TextStyle {
  Normal
  Italic
  Bold
  BoldItalic
}

#derive(Eq, @debug.Debug)
pub(all) enum TextWrap {
  Word
  Char
}

#derive(Eq, @debug.Debug)
pub(all) enum TextureFilter {
  Nearest
  Linear
}

pub(all) enum TextureMode {
  Image
  Normal
}

pub(all) enum TextureWrap {
  Clamp
  Repeat
  Mirror
}

#derive(Eq, @debug.Debug)
pub(all) struct Touch {
  x : Double
  y : Double
  win_x : Double
  win_y : Double
  id : Int32
}

#derive(Eq, @debug.Debug)
pub(all) enum VAlign {
  Top
  VCenter
  Bottom
  Baseline
  Hanging
  Ideographic
}

