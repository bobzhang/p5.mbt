pub using @math {type Matrix2D}

pub using @math {type Noise}

pub using @math {type Random}

pub using @webgl {type Shader}

pub using @shape {type Shape}

pub using @shape {type ShapeKind}

pub using @shape {type ShapeMode}

pub using @shape {type SplineEnds}

pub using @io {type Table}

pub using @io {type TableRow}

pub using @math {type Vector}

pub using @io {type Xml}

pub using @io {type XmlNode}

// Traits
pub(open) trait ColorArg {
  fn to_color(Self, P5) -> @color.Color
}
pub impl ColorArg for Int32
pub impl ColorArg for Double
pub impl ColorArg for String
pub impl ColorArg for @color.Color
pub impl ColorArg for Array[Double]
pub impl[A : Num, B : Num] ColorArg for (A, B)
pub impl[A : Num, B : Num, C : Num] ColorArg for (A, B, C)
pub impl[A : Num, B : Num, C : Num, D : Num] ColorArg for (A, B, C, D)

pub(open) trait ImageSource {
  fn image_source(Self) -> (@dom.ImageElement, Int32, Int32, Double, Double)?
  fn advance(Self, Double) -> Unit = _
  fn gl_source(Self) -> @webgl.TexSource? = _
}
pub impl ImageSource for @webgl.Framebuffer

pub(open) trait Num {
  fn to_num(Self) -> Double
}
pub impl Num for Int32
pub impl Num for Double

pub(open) trait Storable {
  fn to_storage(Self) -> (String, String)
}
pub impl Storable for Bool
pub impl Storable for Int32
pub impl Storable for Double
pub impl Storable for String
pub impl Storable for @color.Color
pub impl Storable for @math.Vector
pub impl Storable for @json.Json

pub(open) trait Surface {
  fn set_transform(Self, @math.Matrix2D) -> Unit
  fn save(Self) -> Unit
  fn restore(Self) -> Unit
  fn fill_path(Self, Array[@shape.PathCmd], String) -> Unit
  fn stroke_path(Self, Array[@shape.PathCmd], String, Double, StrokeCap, StrokeJoin) -> Unit
  fn clip(Self, @math.Matrix2D, Array[(Array[@shape.PathCmd], @math.Matrix2D)]) -> Unit
  fn fill_rect(Self, Double, Double, Double, Double, String) -> Unit
  fn clear_rect(Self, Double, Double, Double, Double) -> Unit
  fn set_blend_mode(Self, BlendMode) -> Unit
  fn set_text_style(Self, String, HAlign, VAlign, String) -> Unit
  fn fill_text(Self, String, Double, Double, String) -> Unit
  fn stroke_text(Self, String, Double, Double, String, Double, StrokeJoin) -> Unit
  fn measure_text(Self, String) -> TextMetrics
  fn draw_image(Self, @dom.ImageElement, Int32, Int32, (Double, Double, Double, Double)?, Double, Double, Double, Double, Double, Double, Double, Double) -> Unit
  fn read_pixels(Self, Int32, Int32, Int32, Int32) -> FixedArray[Byte]
  fn write_pixels(Self, FixedArray[Byte], Int32, Int32, Int32, Int32) -> Unit
  fn resize(Self, Double, Double, Double) -> Unit
  fn set_smoothing(Self, Bool) -> Unit
  fn set_css_filter(Self, String) -> Unit
}
